<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The buttons of a notification category's actions that don't open the app. -->
        <receiver
            android:name="skip.ui.NotificationActionReceiver"
            android:exported="false" />
        <!-- The images of conversation notifications, which SystemUI reads. -->
        <provider
            android:name="skip.ui.NotificationAttachmentProvider"
            android:authorities="${applicationId}.skipui.notifications"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
